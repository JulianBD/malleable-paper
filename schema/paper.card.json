{
  "lexicon": 1,
  "id": "paper.card",
  "status": "draft",
  "node": "#cardfield (frame 3, 'cards · what paper wants')",
  "comment": "the adjudication widget: paper's intent presented on the plane as a form; Julian's ruling returns as an event. The first widget where BOTH directions of the data→infer→intend→act loop run through the log, with chat demoted to signpost.",
  "events": {
    "emits": {
      "card": {
        "type": "object",
        "required": [
          "ts",
          "kind",
          "id",
          "title"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "datetime"
          },
          "kind": {
            "const": "card"
          },
          "id": {
            "type": "string",
            "comment": "fold key — latest card per id wins"
          },
          "title": {
            "type": "string"
          },
          "blurb": {
            "type": "string",
            "comment": "the actual ask: context and decision, above the table"
          },
          "status": {
            "enum": [
              "pending",
              "ruled"
            ],
            "comment": "presentation hint only; a card_response overrides"
          },
          "table": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "form": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "options"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "k",
                          "label"
                        ],
                        "properties": {
                          "k": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "writein": {
                "type": "boolean",
                "comment": "currently unconditional"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "card_response": {
        "type": "object",
        "required": [
          "ts",
          "kind",
          "card",
          "picks",
          "actor"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "datetime"
          },
          "kind": {
            "const": "card_response"
          },
          "card": {
            "type": "string",
            "comment": "the card id being ruled"
          },
          "picks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "note": {
            "type": "string",
            "comment": "the write-in"
          },
          "actor": {
            "type": "string"
          },
          "final": {
            "type": "boolean",
            "comment": "true = ruling (closes card); false = discuss (feedback, card stays open). Missing final counts as NOT a ruling."
          }
        }
      }
    },
    "consumes": [
      "card",
      "card_response"
    ]
  },
  "domain": {
    "fold": "latest card per id; latest card_response per card id",
    "states": {
      "pending": {
        "on": {
          "card_response[final=true]": "ruled",
          "card_response[final=false]": "pending — discussion accretes"
        }
      },
      "ruled": {
        "on": {
          "card[id=self]": "pending — supersede reopens"
        }
      }
    },
    "derives": {
      "outstanding": "cards with no response — the 'what paper wants' list"
    },
    "intents": [
      "rule(picks, note)",
      "discuss(picks, note)"
    ],
    "acts": {
      "rule": {
        "event": "card_response",
        "guard": "card exists and is pending",
        "via": "POST /event from the card form",
        "final": true
      },
      "discuss": {
        "event": "card_response",
        "final": false,
        "guard": "card pending",
        "via": "discuss button"
      }
    }
  },
  "system": {
    "tick": "shared 2000ms chat poll (renderCards called per poll)",
    "ingest": "extension steers card_response into session as '[card HH:MM:SS] ...' (requires /reload after 08:22 edit)"
  },
  "render": {
    "element": "#cardfield",
    "template": "bordered card: title, status badge, blurb (HTML-escaped), optional table, radio fields stacked one per row, write-in textarea, 'rule it' (final) + 'discuss' (non-final) buttons; discussion lines under the form; ruled cards dim and show pretty picks",
    "ephemeral": [
      "radio selection before submit",
      "write-in draft"
    ]
  },
  "knownGaps": [
    "no card_delete / expiry — the T-form-probe test card renders forever (labeled 'ignore')",
    "no agent-side notification beyond the extension steer; a ruled card while the extension is unloaded is silent",
    "writein flag declared in schema but render always shows the textarea",
    "T-form-probe's pre-split response lacks final → card flipped back to pending; acceptable (test card)"
  ]
}